{
  "name": "@stevenlin/sentencex-wasm",
  "collaborators": [
    "Santhosh Thottingal <santhosh.thottingal@gmail.com>"
  ],
  "description": "Sentence segmentation library with wide language support optimized for speed and utility.",
  "version": "0.1.17-patch.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stephanoskomnenos/sentencex.git"
  },
  "main": "nodejs/sentencex_wasm.js",
  "types": "nodejs/sentencex_wasm.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./nodejs/sentencex_wasm.d.ts",
        "require": "./nodejs/sentencex_wasm.js",
        "import": "./nodejs/sentencex_wasm.js"
      },
      "bun": {
        "types": "./nodejs/sentencex_wasm.d.ts",
        "import": "./nodejs/sentencex_wasm.js"
      },
      "deno": {
        "types": "./nodejs/sentencex_wasm.d.ts",
        "import": "./nodejs/sentencex_wasm.js"
      },
      "bundler": {
        "types": "./bundler/sentencex_wasm.d.ts",
        "import": "./bundler/sentencex_wasm.js"
      },
      "default": {
        "types": "./web/sentencex_wasm.d.ts",
        "import": "./web/sentencex_wasm.js"
      }
    }
  },
  "files": [
    "nodejs/",
    "web/",
    "bundler/"
  ],
  "keywords": [
    "nlp",
    "sentences",
    "multilingual"
  ]
}
